# ---------- 模型：任选一个 OpenAI 兼容服务 ----------
# DeepSeek（推荐，便宜）： LLM_BASE_URL=https://api.deepseek.com      LLM_MODEL=deepseek-chat
# OpenAI：                LLM_BASE_URL=https://api.openai.com/v1     LLM_MODEL=gpt-4o-mini
# 本地 Ollama：            LLM_BASE_URL=http://127.0.0.1:11434/v1    LLM_MODEL=qwen2.5:7b
# 本地 LM Studio：         LLM_BASE_URL=http://127.0.0.1:1234/v1     LLM_MODEL=你加载的模型
# 其他兼容网关：           填它的地址和模型名即可
#
# 只有 api.deepseek.com 和 api.openai.com 必须填 key；
# 本地 / 自建 / 局域网网关可以留空，程序会自动带一个占位 key。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=1024

# ---------- 服务 ----------
# 网页端口，改了之后手机/浏览器地址也要跟着改
PORT=8010

# ---------- 上下文与记忆 ----------
CONTEXT_TOKEN_LIMIT=2000
KEEP_RECENT_MESSAGES=4
# 「关于我」最多保留多少条（超出自动删最旧的）
MAX_FACTS=60

# ---------- 存储 ----------
DB_PATH=data/chatbot.db

# ---------- 提示词文件 ----------
SYSTEM_PROMPT_FILE=prompts/system.md
HANDBOOK_FILE=prompts/profile.md

# ---------- 品牌文案 ----------
BOT_NAME=小助
BOT_EMOJI=🧭
BOT_TAGLINE=个人助理
PAGE_TITLE=小助 · 我的助理
WELCOME_TITLE=今天想先处理哪件事？
WELCOME_SUB=日程、待办、写东西、做决定，都可以丢给我；关于你的事我会记在「关于我」里。
INPUT_HINT=说件事，或者贴一段要改的文字…
EXAMPLE_QUESTIONS=帮我排一下今天的待办|写封邮件请假一天|这个周末怎么安排比较好|帮我把这段话改得更客气
BOT_ACCENT=#2f6f6b
BOT_ACCENT_SOFT=#e3efed
STORAGE_KEY=assistant.session
